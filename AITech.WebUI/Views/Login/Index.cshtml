@using AITech.WebUI.DTOs.AppUserDtos
@model LoginDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Admin Giriş</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="height: 100vh;">

    <div class="card shadow p-4" style="width: 400px;">
        <h3 class="text-center mb-4">Admin Paneli</h3>

        <form method="post">
            <div class="mb-3">
                <label>Kullanıcı Adı</label>
                <input type="text" asp-for="Username" class="form-control" placeholder="Kullanıcı adınızı giriniz" />
            </div>

            <div class="mb-3">
                <label>Şifre</label>
                <input type="password" asp-for="Password" class="form-control" placeholder="******" />
            </div>

            <div class="text-danger mb-3" asp-validation-summary="ModelOnly"></div>

            <button type="submit" class="btn btn-primary w-100">Giriş Yap</button>

            <div class="text-center mt-3">
                <small class="text-muted">Hesabın yok mu?</small>
                <a href="/Login/Register" class="text-decoration-none fw-bold">Kayıt Ol</a>
            </div>
        </form>
    </div>

</body>
</html>