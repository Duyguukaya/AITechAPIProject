@model List<ResultFAQDto>

@{
    
    int count = Model.Count;
    int half = (count + 1) / 2;

    var leftColumn = Model.Take(half).ToList();
    var rightColumn = Model.Skip(half).ToList();
}

@*
   _FAQComponent
*@

<div class="container-fluid py-5">
    <div class="container py-5">
        <div class="mx-auto text-center wow fadeIn" data-wow-delay="0.1s" style="max-width: 500px;">
            <div class="btn btn-sm border rounded-pill text-primary px-3 mb-3">Merak Ettikleriniz</div>
            <h1 class="mb-4">Sıkça Sorulan Sorular</h1>
        </div>
        <div class="row">

            <div class="col-lg-6">
                <div class="accordion" id="accordionFAQ1">
                    @foreach (var item in leftColumn)
                    {
                        <div class="accordion-item wow fadeIn" data-wow-delay="0.1s">
                            <h2 class="accordion-header" id="heading-@item.Id">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                        data-bs-target="#collapse-@item.Id" aria-expanded="false" aria-controls="collapse-@item.Id">
                                    @item.Question
                                </button>
                            </h2>
                            <div id="collapse-@item.Id" class="accordion-collapse collapse" aria-labelledby="heading-@item.Id"
                                 data-bs-parent="#accordionFAQ1">
                                <div class="accordion-body">
                                    @item.Answer
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-6">
                <div class="accordion" id="accordionFAQ2">
                    @foreach (var item in rightColumn)
                    {
                        <div class="accordion-item wow fadeIn" data-wow-delay="0.1s">
                            <h2 class="accordion-header" id="heading-@item.Id">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                        data-bs-target="#collapse-@item.Id" aria-expanded="false" aria-controls="collapse-@item.Id">
                                    @item.Question
                                </button>
                            </h2>
                            <div id="collapse-@item.Id" class="accordion-collapse collapse" aria-labelledby="heading-@item.Id"
                                 data-bs-parent="#accordionFAQ2">
                                <div class="accordion-body">
                                    @item.Answer
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>