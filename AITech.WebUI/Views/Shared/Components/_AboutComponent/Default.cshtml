@model AITech.WebUI.Models.AboutViewModel

@*
   _AboutComponent 
*@
<div class="container-fluid py-5">
    <div class="container">
        <div class="row g-5 align-items-center">

            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.1s">
                <div class="about-img">
                    <img class="img-fluid" src="@Model.About.ImageUrl">
                </div>
            </div>

            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.5s">
                <div class="btn btn-sm border rounded-pill text-primary px-3 mb-3">Hakkımızda</div>

                <h1 class="mb-4">@Model.About.Title</h1>

                <p class="mb-4">
                    @Model.About.Description
                </p>

                <div class="row g-3">
                    @foreach (var item in Model.AboutItems)
                    {
                        <div class="col-sm-6">
                            <h6 class="mb-3">
                                <i class="fa fa-check text-primary me-2"></i>@item.Title
                            </h6>
                        </div>
                    }
                </div>

                <div class="d-flex align-items-center mt-4">
                  

                    @foreach (var social in Model.Social)
                    {
                        <a class="btn btn-outline-primary btn-square me-3" href="@social.Url" target="_blank">
                            <i class="@social.Icon"></i>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>