@model List<ResultFeatureDto>

@*
   _FeatureComponent
*@
<div class="container-fluid bg-light mt-5 py-5">
    <div class="container py-5">
        <div class="row g-5 align-items-center">

            <div class="col-lg-5 wow fadeIn" data-wow-delay="0.1s">
                <div class="btn btn-sm border rounded-pill text-primary px-3 mb-3">Hizmetlerimiz</div>
                <h1 class="mb-4">İşletmeniz İçin Mükemmel Yapay Zeka Çözümleri</h1>
                <p class="mb-4">
                    Teknolojinin sınırlarını zorlayarak iş süreçlerinizi optimize ediyoruz.
                    Verimliliği artıran, maliyetleri düşüren ve geleceği bugünden yakalamanızı sağlayan
                    akıllı algoritmalarımızla tanışın. Rakiplerinizin bir adım önüne geçmek için doğru yerdesiniz.
                </p>

                <a class="btn btn-primary rounded-pill px-4" href="#" data-bs-toggle="modal" data-bs-target="#featureMoreModal">Daha Fazla Oku</a>
            </div>

            <div class="col-lg-7">
                <div class="row g-4">

                    <div class="col-md-6">
                        <div class="row g-4">
                            @foreach (var item in Model.Take(2))
                            {
                                <div class="col-12 wow fadeIn" data-wow-delay="0.1s">
                                    <div class="service-item d-flex flex-column justify-content-center text-center rounded h-100">
                                        <div class="service-icon btn-square">
                                            <i class="@item.Icon fa-2x"></i>
                                        </div>
                                        <h5 class="mb-3">@item.Ttile</h5>
                                        <p>@item.Description</p>
                                        <a class="btn px-3 mt-auto mx-auto" href="/Service/Detail/@item.Id">Detaylar</a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="row g-4">
                            @foreach (var item in Model.Skip(2).Take(2))
                            {
                                <div class="col-12 wow fadeIn" data-wow-delay="0.5s">
                                    <div class="service-item d-flex flex-column justify-content-center text-center rounded h-100">
                                        <div class="service-icon btn-square">
                                            <i class="@item.Icon fa-2x"></i>
                                        </div>
                                        <h5 class="mb-3">@item.Ttile</h5>
                                        <p>@item.Description</p>
                                        <a class="btn px-3 mt-auto mx-auto" href="/Service/Detail/@item.Id">Detaylar</a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="featureMoreModal" tabindex="-1" aria-labelledby="featureMoreModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="featureMoreModalLabel">Geleceğin Teknolojisiyle İşinizi Büyütün</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <h4 class="text-primary mb-3">Neden AI Çözümleri?</h4>
                        <p>
                            Modern iş dünyasında veri, en değerli varlıktır. Ancak bu veriyi işleyip anlamlı içgörülere dönüştürmek uzmanlık gerektirir.
                            AI.Tech olarak sunduğumuz yapay zeka tabanlı çözümler, karmaşık veri setlerini analiz ederek stratejik kararlar almanızı kolaylaştırır.
                        </p>
                        <hr />
                        <div class="row mt-4">
                            <div class="col-md-6 mb-3">
                                <h6 class="fw-bold"><i class="fa fa-chart-line text-success me-2"></i> Verimlilik Artışı</h6>
                                <p class="small text-muted">Otomatikleştirilmiş süreçler sayesinde insan hatasını azaltın ve operasyonel hızınızı %40'a varan oranlarda artırın.</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <h6 class="fw-bold"><i class="fa fa-coins text-success me-2"></i> Maliyet Tasarrufu</h6>
                                <p class="small text-muted">Gereksiz kaynak kullanımını engelleyen akıllı algoritmalar ile bütçenizi en verimli şekilde yönetin.</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <h6 class="fw-bold"><i class="fa fa-users text-success me-2"></i> Müşteri Memnuniyeti</h6>
                                <p class="small text-muted">7/24 hizmet veren chatbotlar ve kişiselleştirilmiş öneri sistemleriyle müşteri deneyimini zirveye taşıyın.</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <h6 class="fw-bold"><i class="fa fa-shield-alt text-success me-2"></i> Güvenlik & Analiz</h6>
                                <p class="small text-muted">Siber tehditleri önceden sezen güvenlik protokolleri ve derinlemesine pazar analizleriyle riskleri minimize edin.</p>
                            </div>
                        </div>
                        <p class="mt-2 fst-italic text-center">
                            "Yapay zeka bir seçenek değil, rekabette kalmak isteyen işletmeler için bir zorunluluktur."
                        </p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
               
            </div>
        </div>
    </div>
</div>