@using AITech.WebUI.DTOs.TeamDtos
@model List<ResultTeamDto>

@*
   _TeamComponent
*@

<div class="container-fluid bg-light py-5">
    <div class="container py-5">
        <div class="row g-5 align-items-center">

            <div class="col-lg-5 wow fadeIn" data-wow-delay="0.1s">
                <div class="btn btn-sm border rounded-pill text-primary px-3 mb-3">Ekibimiz</div>
                <h1 class="mb-4">Deneyimli Uzman Kadromuzla Tanışın</h1>
                <p class="mb-4">
                    Başarının arkasındaki en büyük güç, tutkulu ve uzman bir ekiptir.
                    Mühendislerimiz, veri bilimcilerimiz ve strateji uzmanlarımızla
                    işletmeniz için en doğru çözümleri üretiyoruz.
                </p>
                <a class="btn btn-primary rounded-pill px-4" href="/Contact/Index">Bize Katılın</a>
            </div>

            <div class="col-lg-7">
                <div class="row g-4">

                    <div class="col-md-6">
                        <div class="row g-4">
                            @foreach (var item in Model.Take(2))
                            {
                                <div class="col-12 wow fadeIn" data-wow-delay="0.1s">
                                    <div class="team-item bg-white text-center rounded p-4 pt-0">
                                        <img class="img-fluid rounded-circle p-4" src="@item.ImageUrl" alt="@item.Title">
                                        <h5 class="mb-0">@item.Title</h5> <small>Yapay Zeka Mühendisi</small> <div class="d-flex justify-content-center mt-3">
                                            <a class="btn btn-square btn-primary m-1" href="@item.GithubUrl" target="_blank">
                                                <i class="fab fa-github"></i>
                                            </a>
                                            <a class="btn btn-square btn-primary m-1" href="@item.TwiterUrl" target="_blank">
                                                <i class="fab fa-twitter"></i>
                                            </a>
                                            <a class="btn btn-square btn-primary m-1" href="@item.InstagramUrl" target="_blank">
                                                <i class="fab fa-instagram"></i>
                                            </a>
                                            <a class="btn btn-square btn-primary m-1" href="@item.LinledinUrl" target="_blank">
                                                <i class="fab fa-linkedin-in"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-md-6 ">
                        <div class="row g-4">
                            @foreach (var item in Model.Skip(2).Take(2))
                            {
                                <div class="col-12 wow fadeIn" data-wow-delay="0.5s">
                                    <div class="team-item bg-white text-center rounded p-4 pt-0">
                                        <img class="img-fluid rounded-circle p-4" src="@item.ImageUrl" alt="@item.Title">
                                        <h5 class="mb-0">@item.Title</h5>
                                        <small>Yazılım Mimarı</small>

                                        <div class="d-flex justify-content-center mt-3">
                                            <a class="btn btn-square btn-primary m-1" href="@item.GithubUrl" target="_blank"><i class="fab fa-github"></i></a>
                                            <a class="btn btn-square btn-primary m-1" href="@item.TwiterUrl" target="_blank"><i class="fab fa-twitter"></i></a>
                                            <a class="btn btn-square btn-primary m-1" href="@item.InstagramUrl" target="_blank"><i class="fab fa-instagram"></i></a>
                                            <a class="btn btn-square btn-primary m-1" href="@item.LinledinUrl" target="_blank"><i class="fab fa-linkedin-in"></i></a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>