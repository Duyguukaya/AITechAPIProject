@model CreateTeamDto
@{
    ViewData["Title"] = "CreateTeam";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h3>Yeni Takım Arkadaşı Ekleme Sayfası</h3>

<form method="post">

    <label>Fotoğraf Url</label>
    <input type="text" asp-for="ImageUrl" class="form-control" />

    <br />
    <label>Unvan</label>
    <input type="text" asp-for="Title" class="form-control" />

    <br />
    <label>Twitter Url</label>
    <input type="text" asp-for="TwiterUrl" class="form-control" />

    <br />
    <label>Instagram Url</label>
    <input type="text" asp-for="InstagramUrl" class="form-control" />

    <br />
    <label>Linkedin Url</label>
    <input type="text" asp-for="LinledinUrl" class="form-control" />

    <br />
    <label>Github Url</label>
    <input type="text" asp-for="GithubUrl" class="form-control" />

    <br />

    <button class="btn btn-primary">Kaydet</button>
</form>

