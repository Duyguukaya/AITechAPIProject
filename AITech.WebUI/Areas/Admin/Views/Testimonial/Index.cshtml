@model List<ResultTestimonialDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var count = 0;
}

<h3>Referanslar</h3>


<table class="table table-bordered">
    <tr>
        <th>#</th>
        <th>Başlık</th>
        <th>İsim</th>
        <th>Yorum</th>
        <th>İşlemler</th>
    </tr>
    @foreach (var item in Model)
    {
        count++;

        <tr>
            <td>@count</td>
            <td><img src="@item.ImageUrl" style="height:75px; width:75px; border-radius:50%" alt="Hakkında görseli" />  @item.Title</td>
            <td>@item.Name</td>
            <td>@item.Comment</td>
            <td>
                <a href="/Admin/Testimonial/DeleteTestimonial/@item.Id" class="btn btn-danger">Sil</a>
                <a href="/Admin/Testimonial/UpdateTestimonial/@item.Id" class="btn btn-info">Güncelle</a>
            </td>
        </tr>
    }
</table>

<a href="/Admin/Testimonial/CreateTestimonial" class="btn btn-primary">Yeni Yorum Oluştur</a>

