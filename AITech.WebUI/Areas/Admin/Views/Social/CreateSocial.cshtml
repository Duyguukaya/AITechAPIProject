@model CreateSocialDto
@{
    ViewData["Title"] = "CreateSocial";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h3>Yeni Sosyal Medya Oluşturma Sayfası</h3>

<form method="post">
    <label>Sosyal Medya Adı</label>
    <input type="text" asp-for="Name" class="form-control" />

    <br />
    <label>İkon</label>
    <input type="text" asp-for="Icon" class="form-control" />

    <br />
    <label>Url</label>
    <input type="text" asp-for="Url" class="form-control" />

    <br />

    <button class="btn btn-primary">Kaydet</button>
</form>


